# Server-only values for the Next.js app/Vercel. Never use NEXT_PUBLIC_ or EXPO_PUBLIC_.
ATTENDANCE_API_URL=https://attendance-api.example.com
ATTENDANCE_API_TOKEN=
ATTENDANCE_CF_ACCESS_CLIENT_ID=
ATTENDANCE_CF_ACCESS_CLIENT_SECRET=
# Local development may use http://127.0.0.1:4010 without Cloudflare credentials.
# For MikroTik HTTPS forwarding, explicitly choose bearer authentication:
# ATTENDANCE_API_AUTH_MODE=bearer
# ATTENDANCE_API_URL=https://85.112.75.82:4010
# Optional public CA PEM for a private certificate (never paste its private key).
# ATTENDANCE_API_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
