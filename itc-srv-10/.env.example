# Run only on the internal server. Never copy SQL credentials to Vercel/mobile.
HOST=127.0.0.1
PORT=4010
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ATTENDANCE_API_TOKEN=
MSSQL_SERVER=ITC-SRV-10
MSSQL_INSTANCE=CORP
# Prefer a fixed TCP port instead of instance discovery; omit INSTANCE when using PORT.
# MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false
# Optional corporate CA file (PEM), trusted by Node:
# NODE_EXTRA_CA_CERTS=C:/certificates/corporate-ca.pem
REPORTS_FILE=./config/reports.json
# Optional migrated settings file; environment variables take precedence.
# MSSQL_SETTINGS_FILE=./config/mssql-settings.json
RATE_LIMIT_PER_MINUTE=120
